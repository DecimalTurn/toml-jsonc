{
  "name": "toml-to-jsonc",
  "version": "0.2.0",
  "description": "Convert between TOML and JSONC with comments preserved, using the same Python converters as the TOML ⇄ JSONC browser utility.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/",
    "vendor/"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "sync": "node scripts/sync-python.mjs",
    "prepare": "node scripts/sync-python.mjs",
    "pretest": "node scripts/sync-python.mjs",
    "test": "node --test",
    "prepack": "node scripts/sync-python.mjs"
  },
  "dependencies": {
    "pyodide": "^314.0.7"
  },
  "keywords": [
    "toml",
    "jsonc",
    "json",
    "convert",
    "converter",
    "comments",
    "pyodide",
    "bidirectional"
  ],
  "license": "UNLICENSED"
}
